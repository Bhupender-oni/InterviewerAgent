# LLM Provider: ollama, groq, or openai
LLM_PROVIDER=ollama

# Ollama (local LLM - must be running on localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama2:7b

# Groq (free cloud API - get key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
CONVERSATION_MEMORY=6

# Data Paths
CURRICULUM_PATH=sample_data/curriculum.json
CANDIDATE_PROFILES_PATH=sample_data/candidates.json

# Server
HOST=0.0.0.0
PORT=8000
